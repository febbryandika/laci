    },
    "Semua penjualan, stok, dan tutup kas setelah %@ akan hilang dan tidak bisa dikembalikan.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All sales, stock and close-outs after %@ will be lost and cannot be recovered."
