# SwiftFormat. CI runs `swiftformat --lint .` with the version pinned in ci.yml's lint job.
# Near-default on purpose; the Swift version is pinned so rule selection does not depend
# on which toolchain or SwiftFormat build is present.
--swiftversion 6.0
--indent 4
--commas always
--header ignore
--exclude .build,build,DerivedData,Packages/*/.build,**/.build
